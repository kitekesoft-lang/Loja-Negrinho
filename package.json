{
  "name": "kitekepro",
  "productName": "Kiteke Pro",
  "description": "Kiteke Pro - Sistema de Gestão Empresarial e Faturação Certificada",
  "author": "KitekeSoft",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js release",
    "lint": "tsc --noEmit",
    "desktop:dev": "vite build && electron electron/main/main.cjs",
    "desktop:build": "vite build && electron-builder --win",
    "desktop:build:win": "vite build && electron-builder --win",
    "desktop:build:win:x64": "vite build && electron-builder --win --x64",
    "desktop:build:win:x86": "vite build && electron-builder --win --ia32",
    "desktop:package": "vite build && electron-builder --win --dir",
    "package:codespace": "node scripts/package-desktop.cjs",
    "package:codespace:all": "node scripts/package-desktop.cjs --all"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.0",
    "opentype.js": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
